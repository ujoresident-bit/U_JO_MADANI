# Copy to .env for local runs. NEVER commit .env.
# On Render, set these in the service's Environment tab instead.

TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side key: "secret" key (sb_secret_...) or legacy "service_role" key.
# Never use the anon/publishable key here, and never share this key.
SUPABASE_KEY=replace-with-your-server-side-key

# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
